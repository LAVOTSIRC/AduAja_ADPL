# =====================================================
# LOCAL DEVELOPMENT SECRETS
# Copy file ini ke .env lalu isi nilainya.
# File .env TIDAK di-commit ke git (lihat .gitignore)
# =====================================================

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DB Type: h2 atau postgres
DB_TYPE=postgres

# Supabase Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=

# Storage type: postgres atau supabase
STORAGE_TYPE=postgres

# Database (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/aduaja
DATABASE_USER=postgres
DATABASE_PASSWORD=

# H2 Console
H2_CONSOLE_ENABLED=true
H2_CONSOLE_ALLOW_REMOTE=false

# JPA & Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_USE_SQL_COMMENTS=true
JPA_BATCH_SIZE=20

# Thymeleaf
THYMELEAF_CACHE=false

# File Upload
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB

# Hikari Pool
HIKARI_MAX_POOL=10
HIKARI_MIN_IDLE=5

# Security (Spring Security default user — ganti di production!)
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=admin123

# Dev Mode (aktifkan fitur developer: generate test reports, dll.)
DEV_MODE=false

# Brevo API (transactional email — bukan SMTP)
BREVO_API_KEY=
MAIL_FROM=

# Dropbox (opsional — untuk storage alternatif)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Hugging Face API (opsional — untuk AI features)
HF_TOKEN=
